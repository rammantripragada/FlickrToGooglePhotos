# Keep real values in .env, never in Git.
FLICKR_API_KEY=
FLICKR_API_SECRET=
# Register this loopback callback in your Flickr application.
FLICKR_OAUTH_CALLBACK=http://127.0.0.1:8765/callback
# Downloaded Google Desktop OAuth JSON; never commit this file.
GOOGLE_CLIENT_SECRETS_FILE=./credentials/google-client.json
# This file contains migration metadata only, never OAuth access tokens.
MIGRATOR_DATABASE=./flickr-to-google-photos.sqlite3
MIGRATOR_DOWNLOAD_DIR=./downloads
MIGRATOR_LOG_LEVEL=INFO
MIGRATOR_LOG_FILE=./logs/flickr-gphotos.jsonl
# Concurrent Flickr detail/original-URL requests. Keep modest to respect rate limits.
MIGRATOR_INVENTORY_WORKERS=5
# Pause between Flickr original-file requests. Five seconds avoids CDN bursts.
MIGRATOR_DOWNLOAD_INTERVAL_SECONDS=5
